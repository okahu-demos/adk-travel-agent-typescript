# --- Google GenAI (required) ---
GOOGLE_GENAI_API_KEY=<your_google_api_key>
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_MODEL=gemini-2.5-flash-lite
MAX_OUTPUT_TOKENS=1000

# --- Monocle tracing (optional; omit this block to run without tracing) ---
# Preloads Monocle before the app's import graph so it can hook ADK. Node reads
# NODE_OPTIONS out of this file, so it only applies to scripts run with
# --env-file=.env (npm start, start:orchestrator, dev, dev:orchestrator).
NODE_OPTIONS=--import monocle2ai/register

# The name traces are filed under, locally and in Okahu. Tests that load a trace
# from Okahu must pass this same name as workflow_name=.
MONOCLE_WORKFLOW_NAME=adk-travel-agent-typescript

# Comma-separated exporters. "file" writes spans to ./.monocle/*.json;
# "okahu" POSTs them to the Okahu ingestion endpoint below.
MONOCLE_EXPORTER=file,okahu
MONOCLE_ISOLATE_SPANS=true
MONOCLE_INCLUDE_ALL_SPANS=false
LOG_LEVEL=error

# How long the preload holds the event loop open on exit so batched spans can
# flush (ms, default 6000).
# MONOCLE_FLUSH_MS=6000

# Required only when "okahu" is included in MONOCLE_EXPORTER:
OKAHU_API_KEY=<your_okahu_api_key>
OKAHU_INGESTION_ENDPOINT=<your_okahu_ingestion_endpoint>
